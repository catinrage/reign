# Copy this to .env next to compose.yaml; docker compose reads it on its own.

# Password for the Postgres database. Letters and digits only (it goes into a URL), for example
# from `openssl rand -hex 24`. Postgres only takes it when the `db` volume is first created.
POSTGRES_PASSWORD=change-me

# Port the game is published on (http://your-server:8787).
PORT=8787

# Which address that port listens on. 0.0.0.0 is every address; 127.0.0.1 keeps it to the server
# itself, for when Caddy (the https profile) is the way in.
BIND=0.0.0.0

# Domain for the https profile: point its DNS A record at the server first. Left empty, Caddy
# serves https://localhost with its own certificate, which only helps when testing on your own machine.
DOMAIN=

# Copies of the game on other sites (itch.io, CrazyGames: see docs/publishing.md).
# Sites whose pages may use this server, comma separated, * for any part of a name. Empty lets any
# site (safe: a page can only act for a player who signed in on it).
CORS_ORIGINS=
# The game's id on CrazyGames, to turn away sign-ins meant for other games. Optional.
CRAZYGAMES_GAME_ID=

# Usernames (comma separated) that may open the admin panel at https://your-domain/admin, signed
# in on the server's own site. Empty: nobody can.
ADMIN_USERS=
