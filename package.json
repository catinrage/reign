{
	"name": "reign",
	"private": true,
	"license": "PolyForm-Noncommercial-1.0.0",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n server,client -c yellow,cyan \"pnpm dev:server\" \"pnpm dev:client\"",
		"dev:server": "tsx watch src/server/index.ts --dev",
		"dev:client": "vite",
		"build": "vite build",
		"build:offline": "vite build --mode offline",
		"dev:offline": "vite --mode offline",
		"build:itch": "vite build --mode itch && node scripts/package.mjs itch",
		"build:crazygames": "vite build --mode crazygames && node scripts/package.mjs crazygames",
		"start": "tsx src/server/index.ts",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"i18n": "tsx scripts/i18n.ts"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"pg": "^8.23.1",
		"tsx": "^4.20.0",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@fontsource-variable/nunito": "^5.2.0",
		"@fontsource/fusion-pixel-12px-proportional-sc": "5.3.0",
		"@fontsource/pixelify-sans": "^5.2.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^22.0.0",
		"@types/pg": "^8.23.1",
		"@types/three": "^0.180.0",
		"@types/ws": "^8.18.0",
		"concurrently": "^9.2.0",
		"playwright": "^1.56.0",
		"postprocessing": "^6.37.0",
		"prettier": "^3.6.0",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.38.0",
		"svelte-check": "^4.7.6",
		"three": "^0.180.0",
		"typescript": "~6.0.3",
		"vite": "^7.1.0",
		"vitest": "^3.2.0"
	},
	"packageManager": "pnpm@10.14.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"engines": {
		"node": ">=20"
	}
}
